//I want recursive
//Function takes two nodes, left and right
//Compares mirror symmetry across the two nodes' children
//Recursively calls opposite children (left with right, then right with left)
//base case when node has no children

bool childMirror(struct TreeNode* left, struct TreeNode* right) {

    //These two check for base case of child existence asymmetry
    if ((left->left == NULL && right->right != NULL) || (left->left != NULL && right->right == NULL)) {
        return false;
    }
    if ((left->right == NULL && right->left != NULL) || (left->right != NULL && right->left == NULL)) {
        return false;
    }

    //These three handle base case of childlessness
    int x = 0;
    if (left->left == NULL && left->right == NULL) {
        x++;
    }
    if (right->left == NULL && right->right == NULL) {
        x++;
    }
    if (x != 0) {
        x-=1; //0 if only one is childless, 1 if both are childless
        return x;
    }

    //Check for child value symmetry
    if (left->right && (left->right->val != right->left->val)) {
        return false;
    }
    if (left->left && (left->left->val != right->right->val)) {
        return false;
    }

    //recursive call for children
    //All these if statements just handle cases when both nodes have missing children
    bool leftRight, rightLeft;
    if (left->left) {
        leftRight = childMirror(left->left, right->right);
    }
    if (left->right) {
        rightLeft = childMirror(left->right, right->left);
    } 
    if (left->left == NULL) {
        return rightLeft;
    }
    if (left->right == NULL) {
        return leftRight;
    }

    return (leftRight && rightLeft);
}

bool isSymmetric(struct TreeNode* root) {
    if (root->left == NULL || root->right == NULL) {
        if (root->left == NULL && root->right == NULL) {
            return true;
        } else {
            return false;
        }
    }
    if (root->left->val != root->right->val) {
        return false;
    } else {
        return childMirror(root->left, root->right);
    }
}
