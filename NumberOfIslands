int eraseIsland(char** grid, int gridSize, int* gridColSize, int x, int y) {
    //Base case of island being zero
    if (grid[x][y] == '0') {
        return 0;
    }

    //erase current square
    grid[x][y] = '0';

    //above
    if (x > 0) {
        eraseIsland(grid, gridSize, gridColSize, x-1, y);
    }
    //left
    if (y > 0) {
        eraseIsland(grid, gridSize, gridColSize, x, y-1);
    }
    //below
    if (x < gridSize - 1) {
        eraseIsland(grid, gridSize, gridColSize, x+1, y);
    }
    //right
    if (y < gridColSize[x] - 1) {
        eraseIsland(grid, gridSize, gridColSize, x, y+1);
    }
    return 1;
}

int numIslands(char** grid, int gridSize, int* gridColSize) {
    int islands = 0;
    for (int i = 0; i < gridSize; i++) {
        for (int j = 0; j < gridColSize[i]; j++) {
            if (grid[i][j] == '1') {
                eraseIsland(grid, gridSize, gridColSize, i, j);
                islands++;
            }
        }
    }
    return islands;
}
